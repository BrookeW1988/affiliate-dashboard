# Copy of the settings the dashboard needs. `npm run setup` makes a real .env for you.
# Never paste these into a chat, and never commit .env to GitHub.

# The key that unlocks your admin dashboard. `npm run setup` makes one.
ADMIN_KEY=

# From Stripe: Developers > Webhooks > your endpoint > "Signing secret" (starts with whsec_).
# This is the ONLY Stripe setting the dashboard needs. It can't charge, refund or see
# your Stripe account: it only proves a sale message really came from Stripe.
STRIPE_WEBHOOK_SECRET=

# Optional: email new affiliates their link. Leave blank and they just see it on screen.
# RESEND_API_KEY comes from resend.com (free plan is fine).
# EMAIL_FROM must use a domain you've verified in Resend, e.g. Your Business <hello@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Your live address, e.g. https://your-affiliates.netlify.app (tools/links.sh fills this in).
SITE_URL=
